# Copy to .env.local and adjust. Nothing here is secret in v1.

# Cache only. `pnpm redis` starts the container from docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Base URL of the RFI board. Kept in config because the fetcher is the only module allowed
# to speak to it (ADR-005), and because pointing it at a local fixture server is how the
# parser gets exercised without touching the network.
RFI_BASE_URL=https://iechub.rfi.it/ArriviPartenze
